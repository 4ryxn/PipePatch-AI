# Default offline/test behavior. Allowed values: mock, gemini.
ANALYSIS_MODE=mock
# Current stable vision-capable Gemini API model. This is not a mobile setting.
GEMINI_MODEL=gemini-3.5-flash-lite
# Set this only in your local backend/.env when ANALYSIS_MODE=gemini.
# Never place a real key in source code, mobile configuration, chat, or Git.
GEMINI_API_KEY=
# Conservative deterministic gate for the generic parts checklist.
REPAIR_MINIMUM_CONFIDENCE=0.75
# Optional, server-side, user-triggered public OpenStreetMap discovery. Disabled by default.
SUPPLIER_SEARCH_ENABLED=false
# Use a descriptive app/contact value before enabling public provider access.
SUPPLIER_SEARCH_USER_AGENT=PipePatchAI-FinalYearProject/0.1 (local development)
SUPPLIER_SEARCH_CACHE_TTL_SECONDS=900
SUPPLIER_SEARCH_TIMEOUT_SECONDS=5
SUPPLIER_SEARCH_NOMINATIM_MIN_INTERVAL_SECONDS=1
