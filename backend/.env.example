# Default offline/test behavior. Allowed values: mock, gemini.
ANALYSIS_MODE=mock
# Current stable vision-capable Gemini API model. This is not a mobile setting.
GEMINI_MODEL=gemini-3.5-flash-lite
# Set this only in your local backend/.env when ANALYSIS_MODE=gemini.
# Never place a real key in source code, mobile configuration, chat, or Git.
GEMINI_API_KEY=
